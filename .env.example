LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-...
LLM_MODEL=anthropic/claude-haiku-5.5
# Set to "false" if the provider rejects strict json_schema structured output; replies then rely on
# the prompt asking for JSON (no response_format is sent), still validated before use.
LLM_STRUCTURED_OUTPUT=true
# Set to "true" to send thinking: {type: "disabled"} (Anthropic's API only; other providers may
# reject it). Claude Haiku 5.5 thinks by default, which roughly doubles decision latency.
LLM_DISABLE_THINKING=false
# Optional: a different (stronger) model for the morning, daytime, night and weekly reflection
# passes; decisions and conversation summaries keep LLM_MODEL. Leave unset to use LLM_MODEL for all.
# LLM_REFLECTION_MODEL=anthropic/claude-sonnet-5.5
SIM_PORT=8787
SIM_DATABASE_PATH=data/village.db
# "fake" runs the sim offline with a deterministic stand-in for the LLM (no key needed);
# "openai" (the default) uses the OpenAI-compatible endpoint above; "anthropic" uses Anthropic's
# native Messages API (set LLM_BASE_URL=https://api.anthropic.com/v1) with prompt caching.
LLM_PROVIDER=openai
