{
  "name": "village-sim",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "concurrently --names server,client --prefix-colors blue,green --kill-others-on-fail \"npm run dev -w @village/server\" \"npm run dev -w @village/client\"",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "test": "vitest run",
    "reset": "npm run reset -w @village/server",
    "build": "npm run build -w @village/client",
    "generate-map": "tsx scripts/generate-map.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "concurrently": "^9.2.5",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  }
}
