      "target": { "not": { "where": "self" } },
      "reach": 6,
      "steps": [
        { "step": "wait", "minutes": 1, "loudness": 4 },
        { "step": "roll_hit", "chance": 0.6 },
        {
          "step": "damage",
          "on": "target",
          "field": "health.current",
          "amount": { "min": 0.02, "max": 0.05, "times": "item.holdable.kilograms" },
          "scaledByStrength": true
        },
        { "step": "send", "on": "target", "stimulus": "impact" },
        { "step": "move", "on": "item", "at": "target", "evenOnMiss": true },
        { "step": "send", "on": "item", "stimulus": "impact", "evenOnMiss": true }
      ],
      "phrases": {
        "ongoing": "throwing a {item} at {target}",
        "hit": "hit {target} with a thrown {item}",
        "missed": "threw a {item} at {target} and missed",
        "killed": "killed by a {item} thrown by {actor}",
        "attempt": "throw a {item} at {target}"
      }
    },
    {
      "name": "put",
      "appliesTo": { "allOf": [{ "has": "holdable" }, { "where": "held" }] },
      "target": { "has": "capacity" },
      "takes": ["amount"],
      "steps": [
        {
          "step": "move",
          "on": "item",
          "into": "target",
          "limit": { "from": "target.capacity.max" }
        }
      ],
      "phrases": {
        "ongoing": "putting {item} in {target}",
        "done": "put {item} in {target}",
        "attempt": "put {item} in {target}"
      }
    },
    {
      "name": "take",
      "appliesTo": { "allOf": [{ "has": "holdable" }, { "where": "inside" }] },
      "takes": ["amount"],
      "steps": [{ "step": "move", "on": "item", "into": "user" }],
      "phrases": {
        "ongoing": "taking {item} from {from}",
        "done": "took {item} from {from}",
        "attempt": "take {item} from {from}"
      }
    },
    {
      "name": "shoot",
      "appliesTo": {
        "allOf": [
          { "has": "capacity" },
          { "has": "firearm" },
          { "has": "holdable" },
          { "has": "range" },
          { "where": "held" }
        ]
      },
      "target": { "field": "health.current", "above": 0 },
      "reach": { "from": "item.range.tiles" },
      "steps": [
        { "step": "use_up", "in": "item", "rule": { "has": "ammo" }, "count": 1 },
        { "step": "wait", "minutes": 1, "loudness": 30 },
        { "step": "roll_hit", "chance": { "from": "item.firearm.hitChance" } },
        {
          "step": "damage",
          "on": "target",
          "field": "health.current",
          "amount": { "from": "item.firearm.damage" }
        },
        { "step": "send", "on": "target", "stimulus": "cut" }
      ],
      "phrases": {
        "ongoing": "shooting at {target} with a {item}",
        "hit": "shot {target} with a {item}",
        "missed": "shot at {target} and missed",
        "killed": "shot dead by {actor}",
        "attempt": "shoot {target} with a {item}"
      }
    }
  ],
  "rules": [
    {
      "trigger": "stimulus",
      "stimulus": "fire",
      "if": { "allOf": [{ "has": "flammable" }, { "not": { "has": "wet" } }] },
      "steps": [{ "step": "add", "component": "burning", "minutes": 30 }]
    },
    {
      "trigger": "stimulus",
      "stimulus": "fire",
      "if": { "has": "wet" },
      "steps": [{ "step": "remove", "component": "wet" }]
    },
    {
      "trigger": "stimulus",
      "stimulus": "water",
      "if": { "has": "burning" },
      "steps": [{ "step": "remove", "component": "burning" }]
    },
    {
      "trigger": "every",
      "minutes": 1,
      "if": { "has": "burning" },
      "steps": [
        { "step": "damage", "field": "health.current", "amount": 0.01 },
        { "step": "send", "on": "nearby", "radius": 1, "stimulus": "fire", "chance": 0.05 }
      ],
      "killed": "burned to death"
    },
    {
      "trigger": "stimulus",
      "stimulus": "cut",
      "if": { "has": "flesh" },
      "steps": [{ "step": "add", "component": "bleeding", "minutes": 20, "chance": 0.4 }]
    },
    {
      "trigger": "every",
      "minutes": 1,
      "if": { "has": "bleeding" },
      "steps": [{ "step": "damage", "field": "health.current", "amount": 0.01 }],
      "killed": "bled to death"
    },
    {
      "trigger": "every",
      "minutes": 1,
      "if": { "has": "poisoned" },
      "steps": [{ "step": "damage", "field": "health.current", "amount": 0.003 }],
      "killed": "died of poison"
    },
    {
      "trigger": "stimulus",
      "stimulus": "impact",
      "if": { "allOf": [{ "has": "fragile" }, { "has": "burning" }] },
      "steps": [{ "step": "send", "on": "nearby", "radius": 1, "stimulus": "fire" }]
    },
    {
      "trigger": "stimulus",
      "stimulus": "impact",
      "if": { "has": "fragile" },
      "steps": [{ "step": "set", "field": "health.current", "to": 0 }]
    },
    {
      "trigger": "becomes",
      "if": { "allOf": [{ "field": "health.current", "atMost": 0 }, { "has": "breaks_loudly" }] },
      "steps": [{ "step": "sound", "loudness": { "from": "self.breaks_loudly.loudness" } }]
    },
    {
      "trigger": "becomes",
      "if": { "allOf": [{ "field": "health.current", "atMost": 0 }, { "has": "breaks_into" }] },
      "steps": [
        { "step": "announce", "text": "broke" },
        { "step": "transform", "into": { "from": "self.breaks_into.item" } }
      ]
    },
    {
      "trigger": "becomes",
      "if": {
        "allOf": [
          { "field": "health.current", "atMost": 0 },
          { "not": { "has": "breaks_into" } },
          { "not": { "definition": "person" } }
        ]
      },
      "steps": [{ "step": "announce", "text": "broke" }, { "step": "destroy" }]
    },
    {
      "trigger": "every",
      "minutes": 60,
      "if": { "has": "regrows" },
      "steps": [
        { "step": "change", "field": "stock.amount", "by": { "from": "self.regrows.perHour" } }
      ]
    },
    {
      "trigger": "becomes",
      "if": { "allOf": [{ "has": "alive" }, { "field": "health.current", "atMost": 0 }] },
      "steps": [{ "step": "remove", "component": "alive" }]
    },
    {
      "trigger": "becomes",
      "if": { "has": "burning" },
      "steps": [{ "step": "announce", "text": "caught fire" }]
    },
    {
      "trigger": "becomes",
      "if": { "not": { "has": "burning" } },
      "steps": [{ "step": "announce", "text": "stopped burning" }]
    },
    {
      "trigger": "becomes",
      "if": { "has": "bleeding" },
      "steps": [{ "step": "announce", "text": "started bleeding" }]
    },
    {
      "trigger": "becomes",
      "if": { "not": { "has": "bleeding" } },
      "steps": [{ "step": "announce", "text": "stopped bleeding" }]
    },
    {
      "trigger": "becomes",
      "if": { "has": "wet" },
      "steps": [{ "step": "announce", "text": "got wet" }]
    },
    {
      "trigger": "becomes",
      "if": { "not": { "has": "wet" } },
      "steps": [{ "step": "announce", "text": "dried off" }]
    },
    {
      "trigger": "becomes",
      "if": { "has": "poisoned" },
      "steps": [{ "step": "announce", "text": "was poisoned", "isPrivate": true }]
    },
    {
      "trigger": "becomes",
      "if": { "not": { "has": "poisoned" } },
      "steps": [{ "step": "announce", "text": "got over the poison", "isPrivate": true }]
    }
  ]
}
